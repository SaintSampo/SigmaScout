# wrangler local dev state (D1/KV/R2 emulation) — generated, machine-local,
# never the source of truth (the source of truth is the live database
# migrations apply against — see apps/worker/migrations/).
.wrangler/

# apps/web generated output (plan 05-01) — dist/ above already matches these
# at any depth, but listed explicitly for clarity plus the two not yet covered.
apps/web/dist/
apps/web/src/routeTree.gen.ts
apps/web/test-results/
apps/web/playwright-report/


# GSD executor worktrees. Created under .claude/worktrees/ during phase
# execution and normally removed by the cleanup wave — but removal fails on
# Windows whenever an executor left a dev/preview server running inside the
# tree, which is how 11 orphaned worktrees (1.1GB) accumulated through Phase 6.
# Ignoring them keeps a failed cleanup from showing up as ~1200 untracked
# files. They hold no unmerged work: the cleanup wave strips the .git file
# before it fails, so anything committed there is already merged.
.claude/worktrees/
