# The Blue Alliance API v3 key.
# Obtain one from your account settings: https://www.thebluealliance.com/account
# Never commit the real value -- .env is gitignored; this file only documents the shape.
TBA_API_KEY=your-tba-api-key-here

# Cloudflare account ID (D-24). Obtain from the Cloudflare Dashboard -> any zone/R2 overview -> Account ID (right sidebar).
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id-here

# R2 API token access key ID (D-24). Obtain from Cloudflare Dashboard -> R2 -> Manage R2 API Tokens -> Create API token (Object Read & Write, scoped to the sigmascout-artifacts bucket).
R2_ACCESS_KEY_ID=your-r2-access-key-id-here

# R2 API token secret access key (D-24). Shown exactly once on the same token creation screen as R2_ACCESS_KEY_ID above -- copy it immediately.
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key-here

# R2 public bucket URL (D-24). Obtain from Cloudflare Dashboard -> R2 -> sigmascout-artifacts -> Settings -> Public access (the r2.dev subdomain, or a custom domain once one is attached).
R2_PUBLIC_BASE_URL=https://pub-your-bucket-hash-here.r2.dev
