{
  "name": "sigmascout",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:native": "tsx scripts/verify-native-module.ts",
    "recon:tba": "tsx --env-file=.env scripts/recon-tba-fields.ts",
    "ingest": "tsx --env-file=.env packages/ingest/cli.ts",
    "ingest:media": "tsx --env-file=.env packages/ingest/cli.ts --media-only",
    "ingest:rankings": "tsx --env-file=.env packages/ingest/cli.ts --rankings-only",
    "ingest:alliances": "tsx --env-file=.env packages/ingest/cli.ts --alliances-only",
    "ingest:districts": "tsx --env-file=.env packages/ingest/cli.ts --districts-only",
    "ingest:awards": "tsx --env-file=.env packages/ingest/cli.ts --awards-only",
    "ingest:event-teams": "tsx --env-file=.env packages/ingest/cli.ts --event-teams-only",
    "harness": "tsx --env-file=.env packages/harness/cli.ts",
    "identifiability": "tsx packages/harness/identifiability.ts",
    "event-scope-diagnostic": "tsx packages/harness/eventScopeDiagnostic.ts",
    "fingerprint": "tsx packages/harness/baselineFingerprint.ts",
    "gbr:eval": "tsx packages/gbr/evaluate.ts",
    "gbr:holdout": "tsx packages/gbr/holdout.ts",
    "gbr:tune": "tsx packages/gbr/tune.ts",
    "pcm:eval": "tsx packages/pcm/cli.ts",
    "pcm:holdout": "tsx packages/pcm/holdout.ts",
    "rp:conservative-branch": "tsx packages/harness/rpConservativeBranch.ts",
    "rp:golden": "tsx scripts/rpPredictThresholdsGolden.ts",
    "tune": "tsx packages/harness/tune.ts",
    "promote": "tsx packages/harness/promote.ts",
    "measure:rewind-gap": "tsx scripts/measureRewindGap.ts",
    "measure:rp-mean-deficit": "tsx scripts/measureRpMeanDeficit.ts",
    "measure:swing-skill": "tsx scripts/measureSwingSkill.ts",
    "measure:alliance-reconstruction": "tsx scripts/measureAllianceReconstruction.ts",
    "measure:epa-deviations": "tsx scripts/measureEpaDeviations.ts",
    "compare:sigma-score": "tsx scripts/compareSigmaScore.ts",
    "fetch:schedule-templates": "tsx scripts/fetchScheduleTemplates.ts",
    "reparam:equivalence": "tsx scripts/reparamEquivalence.ts",
    "lint:reviews": "tsx scripts/reviewFrontmatterLint.ts",
    "publish:artifacts": "tsx --env-file=.env packages/harness/publish.ts",
    "publish:seasons": "tsx --env-file=.env packages/harness/publish.ts --seasons 2016-2020,2022-2026 --include-offseason --presim-from-season 9999",
    "publish:districts": "tsx --env-file=.env scripts/publishDistricts.ts --years 2016-2020,2022-2026",
    "publish:epa-comparison": "tsx --env-file=.env scripts/publishEpaComparison.ts",
    "verify:subset": "tsx scripts/verifySubsetPublish.ts",
    "mock:rank-distribution": "tsx scripts/mockRankDistribution.ts",
    "manifest:algorithms": "tsx --env-file=.env scripts/publishAlgorithmsManifest.ts",
    "worker:deploy": "pnpm --filter worker run deploy",
    "replay:rig": "tsx --env-file=.env scripts/replayRig.ts",
    "cleanup:retired-objects": "tsx --env-file=.env scripts/deleteRetiredAlgorithmObjects.ts",
    "cleanup:orphaned-demo-teams": "tsx --env-file=.env scripts/deleteOrphanedDemoTeamObjects.ts",
    "recon:fields": "tsx --env-file=.env scripts/recon-breakdown-fields.ts",
    "recon:rp-rates": "tsx --env-file=.env scripts/recon-rp-rates.ts",
    "recon:rp-thresholds": "tsx --env-file=.env scripts/recon-rp-thresholds.ts",
    "recon:rocket-rp": "tsx --env-file=.env scripts/recon-rocket-rp-2019.ts",
    "compare:epa-statbotics": "tsx scripts/epaVsStatbotics.ts"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^24.0.0",
    "ml-matrix": "6.15.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
