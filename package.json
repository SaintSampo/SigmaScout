{
  "name": "sigmascout",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:native": "tsx scripts/verify-native-module.ts",
    "recon:tba": "tsx --env-file=.env scripts/recon-tba-fields.ts",
    "ingest": "tsx --env-file=.env packages/ingest/cli.ts",
    "ingest:media": "tsx --env-file=.env packages/ingest/cli.ts --media-only",
    "ingest:rankings": "tsx --env-file=.env packages/ingest/cli.ts --rankings-only",
    "ingest:alliances": "tsx --env-file=.env packages/ingest/cli.ts --alliances-only",
    "harness": "tsx --env-file=.env packages/harness/cli.ts",
    "identifiability": "tsx packages/harness/identifiability.ts",
    "event-scope-diagnostic": "tsx packages/harness/eventScopeDiagnostic.ts",
    "fingerprint": "tsx packages/harness/baselineFingerprint.ts",
    "rp:conservative-branch": "tsx packages/harness/rpConservativeBranch.ts",
    "tune": "tsx packages/harness/tune.ts",
    "promote": "tsx packages/harness/promote.ts",
    "measure:rewind-gap": "tsx scripts/measureRewindGap.ts",
    "reparam:equivalence": "tsx scripts/reparamEquivalence.ts",
    "lint:reviews": "tsx scripts/reviewFrontmatterLint.ts",
    "publish:artifacts": "tsx --env-file=.env packages/harness/publish.ts",
    "publish:seasons": "tsx --env-file=.env packages/harness/publish.ts --seasons 2022-2026 --include-offseason",
    "verify:subset": "tsx scripts/verifySubsetPublish.ts",
    "mock:rank-distribution": "tsx scripts/mockRankDistribution.ts",
    "manifest:algorithms": "tsx --env-file=.env scripts/publishAlgorithmsManifest.ts",
    "worker:deploy": "pnpm --filter worker run deploy",
    "replay:rig": "tsx --env-file=.env scripts/replayRig.ts",
    "cleanup:retired-objects": "tsx --env-file=.env scripts/deleteRetiredAlgorithmObjects.ts",
    "cleanup:orphaned-demo-teams": "tsx --env-file=.env scripts/deleteOrphanedDemoTeamObjects.ts",
    "recon:tba-2019-2020": "tsx --env-file=.env scripts/recon-tba-fields-2019-2020.ts",
    "recon:rp-rates": "tsx --env-file=.env scripts/recon-rp-rates-2019-2020.ts"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^24.0.0",
    "ml-matrix": "6.15.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
