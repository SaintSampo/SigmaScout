{
  "name": "sigmascout",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "typecheck": "tsc --noEmit && pnpm run typecheck:e2e",
    "typecheck:e2e": "tsc --noEmit -p apps/web/tsconfig.e2e.json",
    "test": "vitest run",
    "ingest": "tsx --env-file=.env packages/ingest/cli.ts",
    "ingest:media": "tsx --env-file=.env packages/ingest/cli.ts --media-only",
    "ingest:rankings": "tsx --env-file=.env packages/ingest/cli.ts --rankings-only",
    "ingest:alliances": "tsx --env-file=.env packages/ingest/cli.ts --alliances-only",
    "ingest:districts": "tsx --env-file=.env packages/ingest/cli.ts --districts-only",
    "ingest:awards": "tsx --env-file=.env packages/ingest/cli.ts --awards-only",
    "ingest:awards-all": "tsx --env-file=.env packages/ingest/cli.ts --awards-all-only",
    "ingest:event-teams": "tsx --env-file=.env packages/ingest/cli.ts --event-teams-only",
    "ingest:teams": "tsx --env-file=.env packages/ingest/cli.ts --teams-only",
    "rp:golden": "tsx scripts/rpPredictThresholdsGolden.ts",
    "measure:field-averaged": "tsx scripts/measureFieldAveragedRanks.ts",
    "measure:rp-mean-deficit": "tsx scripts/measureRpMeanDeficit.ts",
    "measure:match-band": "tsx scripts/measureMatchBandCoverage.ts",
    "measure:award-predictability": "tsx scripts/measureAwardPredictability.ts",
    "measure:award-qualification-impact": "tsx scripts/measureAwardQualificationImpact.ts",
    "lint:reviews": "tsx scripts/reviewFrontmatterLint.ts",
    "publish:artifacts": "tsx --env-file=.env packages/harness/publish.ts",
    "publish:seasons": "tsx --env-file=.env packages/harness/publish.ts --seasons 2016-2020,2022-2026 --include-offseason --presim-from-season 2026 --write-budget",
    "publish:districts": "tsx --env-file=.env scripts/publishDistricts.ts --years 2016-2020,2022-2026",
    "publish:epa-comparison": "tsx --env-file=.env scripts/publishEpaComparison.ts",
    "verify:subset": "tsx scripts/verifySubsetPublish.ts",
    "check:deployed-assets": "tsx scripts/checkDeployedAssets.ts",
    "manifest:algorithms": "tsx --env-file=.env scripts/publishAlgorithmsManifest.ts",
    "worker:deploy": "pnpm --filter worker run deploy",
    "replay:rig": "tsx --env-file=.env scripts/replayRig.ts",
    "cleanup:r2-generations": "tsx --env-file=.env scripts/pruneR2Generations.ts",
    "rebaseline": "tsx scripts/rebaseline.ts",
    "publish:stubs": "tsx --env-file=.env scripts/publishProbeStubs.ts",
    "recon:fields": "tsx --env-file=.env scripts/recon-breakdown-fields.ts",
    "recon:rp-rates": "tsx --env-file=.env scripts/recon-rp-rates.ts",
    "recon:rp-thresholds": "tsx --env-file=.env scripts/recon-rp-thresholds.ts",
    "compare:epa-statbotics": "tsx scripts/epaVsStatbotics.ts --warmup 2016-2020",
    "measure:alliance-win-probability": "tsx scripts/measureAllianceWinProbability.ts",
    "measure:district-award-base-rates": "tsx scripts/measureDistrictAwardBaseRates.ts",
    "measure:selection-agreement": "tsx scripts/measureSelectionAgreement.ts",
    "publish:live-windows": "tsx --env-file=.env scripts/publishLiveWindows.ts",
    "measure:ledger-tenets": "tsx scripts/measureLedgerTenets.ts"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^24.0.0",
    "ml-matrix": "6.15.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
